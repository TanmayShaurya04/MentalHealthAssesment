# Serenova Backend Configuration

PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Security / JWT
JWT_SECRET=serenova-dev-super-secure-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Database (Leave empty for built-in local JSON file storage fallback in development)
MONGODB_URL=
DATABASE_NAME=serenova

# AI Configuration (OpenAI-compatible, e.g. Groq, Together, OpenAI, Ollama)
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
