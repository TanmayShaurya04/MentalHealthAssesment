# ==============================================================================
# Serenova configuration. Copy to .env and fill in. Never commit the real .env.
# ==============================================================================

PORT=8000
ENVIRONMENT=production            # development | production
PUBLIC_URL=https://your-domain.example   # used in email links

# --- Security (REQUIRED in production: the app refuses to start with the default secret) ---
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=https://your-domain.example      # comma separated; never "*"
COOKIE_SECURE=true                # keep true behind HTTPS
COOKIE_SAMESITE=lax               # use "none" only if the API is on a different domain

# --- Demo mode ---
# true  = sample counsellors (labelled "Demo"), demo logins, no small-group hiding. Good for presentations.
# false = real launch: no demo logins, anonymous stats hide groups smaller than MIN_GROUP_SIZE.
DEMO_MODE=false
DEMO_PASSWORD=
MIN_GROUP_SIZE=5

# --- Database (empty = built-in JSON files, fine for demos; use MongoDB for real data) ---
MONGODB_URL=
DATABASE_NAME=serenova

# --- Email (empty SMTP_HOST = emails are printed to the server console) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Serenova <no-reply@your-domain.example>
REMINDERS_ENABLED=true
DAILY_REMINDER_HOUR_UTC=12

# --- AI companion (empty key = built-in offline rule-based companion) ---
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=

# --- Optional error tracking (pip install sentry-sdk) ---
SENTRY_DSN=
