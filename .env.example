# ==============================================================================
# Serenova Environment Configuration Template
# Copy this file to .env in production
# ==============================================================================

# Server Port (assigned dynamically by Render/Railway/Heroku via $PORT)
PORT=8000

# Environment: development | production
ENVIRONMENT=production

# JWT Authentication Secret (use a secure random 32+ character string in production)
JWT_SECRET=serenova-dev-super-secure-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173

# Database Configuration (Optional: if empty, defaults to zero-dependency file-backed JSON storage)
MONGODB_URL=
DATABASE_NAME=serenova

# AI Configuration (Optional: if empty, defaults to the built-in offline Rule-Based Companion)
AI_PROVIDER=groq
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=llama-3.3-70b-versatile
AI_API_KEY=
